{
  "servers": {
    "ado-remote-mcp": {
      "url": "https://mcp.dev.azure.com/devopsabcs",
      "type": "http"
    },
    "ado": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@azure-devops/mcp", "${input:ado_org}", "--authentication", "azcli", "--tenant", "a34c69c7-8959-474a-9690-e98bfb0b55c6"]
    }
  },
  "inputs": [
    {
      "id": "ado_org",
      "type": "promptString",
      "description": "Azure DevOps organization name  (e.g. 'contoso')"
    }
  ]
}
