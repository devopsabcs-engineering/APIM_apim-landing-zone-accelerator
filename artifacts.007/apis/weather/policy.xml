<policies>
	<inbound>
		<base />
		<set-backend-service backend-id="weather-backend" />
	</inbound>
	<backend>
		<base />
	</backend>
	<outbound>
		<base />
		<set-header name="x-demo-environment" exists-action="override">
			<value>{{demo-environment}}</value>
		</set-header>
		<set-header name="x-demo-release" exists-action="override">
			<value>candidate-b</value>
		</set-header>
		<set-header name="x-demo-backend-host" exists-action="override">
			<value>@(context.Request.Url.Host)</value>
		</set-header>
		<set-header name="x-demo-team" exists-action="override">
			<value>retail</value>
		</set-header>
	</outbound>
	<on-error>
		<base />
	</on-error>
</policies>